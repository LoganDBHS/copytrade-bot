# Copy to .env (gitignored). Real values only here, never in config.yaml or code.

# Webull OpenAPI (apply in the app: OpenAPI Management; approval ~1-2 business days)
WEBULL_APP_KEY=
WEBULL_APP_SECRET=

# Alpaca paper (fallback broker adapter) - keys from the paper dashboard
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Discord control bot (bot account in YOUR OWN private server - ToS-compliant)
DISCORD_BOT_TOKEN=

# Safety interlock: must literally be "yes" before mode: live will trade
LIVE_TRADING_ACK=no
